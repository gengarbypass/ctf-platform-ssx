# deploy.sh 会生成首次启动密码。手动部署时填写至少 12 个字符。
CTF_ADMIN_USERNAME=arenaops
CTF_ADMIN_PASSWORD=

# 留空会在持久化数据库中生成并保存会话签名密钥。
CTF_SECRET_KEY=
CTF_TIME_ZONE=Asia/Shanghai

# HTTPS 反向代理部署可绑定 127.0.0.1，并将 CTF_COOKIE_SECURE 设为 1。
CTF_BIND_HOST=0.0.0.0
CTF_PORT=80
CTF_COOKIE_SECURE=0

# 上传请求的总大小上限（MiB）。
CTF_MAX_UPLOAD_MB=16
CTF_BOARD_POLL_SECONDS=4
CTF_WEB_WORKERS=2
CTF_WEB_THREADS=4

# 可按 ECS 所在地域替换为可达的官方基础镜像副本和 PyPI 镜像源。
CTF_PYTHON_IMAGE=python:3.13-slim-bookworm
CTF_PIP_INDEX_URL=https://pypi.org/simple
